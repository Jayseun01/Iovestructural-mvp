# ============================================================================
# SESSION STATE FOR NAVIGATION
# ============================================================================

if "current_page" not in st.session_state:
    st.session_state.current_page = "home"

# ============================================================================
# TOOL DEFINITIONS
# ============================================================================

TOOLS = {
    "staircase": {
        "name": "Staircase Designer",
        "icon": "🏗️",
        "description": "Design custom staircases with parametric reinforcement scheduling. Automatically calculates riser heights, reinforcement patterns, and material quantities.",
        "status": "new",
        "module": "tools.staircase_designer",
    },
    "beam": {
        "name": "Beam Detail Designer",
        "icon": "🌉",
        "description": "Design and detail reinforced concrete beams with automatic rebar scheduling and detailing as per standards.",
        "status": "active",
        "module": "tools.tool2",
    },
    "tool3": {
        "name": "Tool 3",
        "icon": "🔧",
        "description": "Advanced engineering calculation tool with real-time analysis and optimization.",
        "status": "active",
        "module": "tools.tool3",
    },
    "tool4": {
        "name": "Tool 4",
        "icon": "⚙️",
        "description": "Specialized structural design tool for complex configurations.",
        "status": "active",
        "module": "tools.tool4",
    },
    "tool5": {
        "name": "Tool 5",
        "icon": "🛠️",
        "description": "Additional engineering utility for quick calculations and analysis.",
        "status": "active",
        "module": "tools.tool5",
    },
}

# ============================================================================
# HOME PAGE
# ============================================================================

if st.session_state.current_page == "home":
    
    # Header
    st.markdown("""
    <div class="header">
        <h1>🏗️ iLoveStructural</h1>
        <p>Professional Engineering Design Tools Platform</p>
    </div>
    """, unsafe_allow_html=True)
    
    st.markdown("")  # Spacer
    
    # Tools grid
    st.markdown("""
    <div class="tools-grid">
    """, unsafe_allow_html=True)
    
    cols = st.columns(3)
    
    for idx, (tool_id, tool_info) in enumerate(TOOLS.items()):
        col = cols[idx % 3]
        
        with col:
            # Create clickable card
            if st.button(
                f"""
{tool_info['icon']}

**{tool_info['name']}**

{tool_info['description']}
                """,
                key=f"tool_btn_{tool_id}",
                use_container_width=True,
                help=f"Click to open {tool_info['name']}",
            ):
                st.session_state.current_page = tool_id
                st.rerun()
            
            # Status badge
            status_class = "status-new" if tool_info["status"] == "new" else "status-active"
            status_text = "🆕 NEW" if tool_info["status"] == "new" else "✅ ACTIVE"
            
            st.markdown(
                f'<div class="tool-status {status_class}">{status_text}</div>',
                unsafe_allow_html=True
            )
    
    st.markdown("</div>", unsafe_allow_html=True)
    
    # Footer
    st.markdown(f"""
    <div class="footer">
        <p><strong>iLoveStructural</strong> © {datetime.now().year} | Professional Engineering Design</p>
        <p style="font-size: 0.9rem; color: #999;">All tools are production-ready and standards-compliant</p>
    </div>
    """, unsafe_allow_html=True)

# ============================================================================
# TOOL PAGES
# ============================================================================

else:
    tool_id = st.session_state.current_page
    tool_info = TOOLS.get(tool_id, {})
    
    # Back button in sidebar
    with st.sidebar:
        if st.button("← Back to Home", use_container_width=True):
            st.session_state.current_page = "home"
            st.rerun()
    
    # Tool header
    st.markdown(f"""
    <div class="tool-header">
        <div class="tool-header-icon">{tool_info.get('icon', '🔧')}</div>
        <div>
            <h1>{tool_info.get('name', 'Tool')}</h1>
            <p>{tool_info.get('description', '')}</p>
        </div>
    </div>
    """, unsafe_allow_html=True)
    
    st.markdown("---")
    
    # Load and run the tool
    try:
        module_name = tool_info.get("module")
        
        if module_name == "tools.staircase_designer":
            # Import and run staircase tool
            from tools.staircase_designer import run
            run()
        
        elif module_name == "tools.tool2":
            # Import and run tool 2
            from tools.tool2 import run
            run()
        
        elif module_name == "tools.tool3":
            from tools.tool3 import run
            run()
        
        elif module_name == "tools.tool4":
            from tools.tool4 import run
            run()
        
        elif module_name == "tools.tool5":
            from tools.tool5 import run
            run()
        
        else:
            st.error(f"Tool module {module_name} not found")
    
    except ImportError as e:
        st.error(f"Could not load tool: {str(e)}")
        st.info(f"Make sure the tool module exists in the tools/ folder")
    
    except Exception as e:
        st.error(f"Error running tool: {str(e)}")
        st.info("Check the tool's run() function for errors")
